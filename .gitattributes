# Force LF line endings for scripts and text files so the evaluation host (Linux)
# can execute and read them directly, regardless of the local `core.autocrlf`
# setting. Without this, a Windows checkout can leak CRLF into `*.sh` and break
# `bash eval.sh` with "bad interpreter" / stray `\r`.
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
